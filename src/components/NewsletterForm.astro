---
/**
 * Componente de formulario de suscripción a la newsletter.
 *
 * Funciona con y sin JavaScript (progressive enhancement).
 * Con JS activo, intercepta el submit vía fetch para una experiencia
 * sin recarga. Sin JS, envía mediante POST tradicional al endpoint.
 *
 * @component
 * @example
 *   <NewsletterForm />
 */
import { newsletterConfig } from "../config/newsletter";
import type { NewsletterConfig } from "../config/newsletter";

const config: NewsletterConfig = newsletterConfig;
---

<section class="newsletter reveal" aria-label="Suscripción a la newsletter">
    <div class="newsletter__inner">
        <h2 class="newsletter__title">Únete a la newsletter</h2>
        <p class="newsletter__subtitle">
            Recibe novedades del estudio, contenido exclusivo de desarrollo, tutoriales de GameDev y más.
        </p>

        <form
            class="newsletter__form"
            id="newsletter-form"
            action={config.endpoint}
            method="POST"
            data-config={JSON.stringify(config)}
        >
            <label class="newsletter__label visually-hidden" for="newsletter-email">
                Email
            </label>

            <div class="newsletter__row">
                <input
                    class="newsletter__input"
                    type="email"
                    id="newsletter-email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="tu@email.com"
                    inputmode="email"
                />

                <!-- Honeypot: campo oculto para atrapar bots -->
                <input
                    class="newsletter__hp visually-hidden"
                    type="text"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                />

                <button class="newsletter__button" type="submit">
                    Suscribirse
                </button>
            </div>

            <p
                class="newsletter__message"
                role="status"
                aria-live="polite"
                id="newsletter-message"
            ></p>
        </form>

        <noscript>
            <p class="newsletter__noscript">
                El formulario también funciona sin JavaScript. Si encuentras
                problemas, verifica que tu navegador soporte el envío de
                formularios estándar.
            </p>
        </noscript>
    </div>
</section>

<script is:inline>
    (function () {
        var form = document.getElementById("newsletter-form");
        if (!form) return;

        var CONFIG = JSON.parse(form.getAttribute("data-config") || "{}");

        var input = /** @type {HTMLInputElement} */ (
            form.querySelector("#newsletter-email")
        );
        var button = /** @type {HTMLButtonElement} */ (
            form.querySelector(".newsletter__button")
        );
        var message = document.getElementById("newsletter-message");
        var honeypot = /** @type {HTMLInputElement} */ (
            form.elements["website"]
        );

        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        function setMessage(text, type) {
            message.textContent = text;
            message.className = "newsletter__message";
            if (type) {
                message.classList.add("newsletter__message--" + type);
            }
        }

        function setLoading(isLoading) {
            if (isLoading) {
                button.classList.add("is-loading");
                button.setAttribute("aria-busy", "true");
                button.textContent = CONFIG.messages.loading;
                input.disabled = true;
                button.disabled = true;
            } else {
                button.classList.remove("is-loading");
                button.removeAttribute("aria-busy");
                button.textContent = "Suscribirse";
                input.disabled = false;
                button.disabled = false;
            }
        }

        function clearStates() {
            button.classList.remove("is-success", "is-error");
            input.classList.remove("is-error");
            message.className = "newsletter__message";
        }

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            clearStates();

            var email = input.value.trim();

            // Validación cliente del email
            if (!emailRegex.test(email)) {
                input.classList.add("is-error");
                setMessage(CONFIG.messages.invalidEmail, "error");
                input.focus();
                return;
            }

            // Honeypot: si el campo oculto tiene valor, es un bot
            if (honeypot && honeypot.value.trim() !== "") {
                setMessage(CONFIG.messages.success, "success");
                form.reset();
                return;
            }

            setLoading(true);

            try {
                var res = await fetch(CONFIG.endpoint, {
                    method: "POST",
                    mode: "cors",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        email: email,
                        website: honeypot ? honeypot.value : "",
                    }),
                });

                var data = null;
                try {
                    data = await res.json();
                } catch (_) {
                    // Si la respuesta no tiene JSON válido, se trata como error
                }

                if (res.ok && data && data.success === true) {
                    setMessage(
                        data.message || CONFIG.messages.success,
                        "success"
                    );
                    button.classList.add("is-success");
                    form.reset();
                } else if (res.status === 429) {
                    // Rate limiting del WAF de Cloudflare
                    setMessage(
                        "Demasiados intentos. Espera un momento.",
                        "error"
                    );
                    button.classList.add("is-error");
                } else {
                    setMessage(
                        (data && data.message) || CONFIG.messages.error,
                        "error"
                    );
                    button.classList.add("is-error");
                }
            } catch (_) {
                setMessage(CONFIG.messages.error, "error");
                button.classList.add("is-error");
            } finally {
                setLoading(false);
            }
        });
    })();
</script>

<style>
    /* ─── Newsletter Section ─────────────────────────────── */
    .newsletter {
        /* Tokens locales para estados del formulario */
        --newsletter-success: #4ade80;
        --newsletter-error: #f87171;
        --newsletter-on-accent: #0b0d12;
        --newsletter-accent-ring: rgba(124, 131, 253, 0.25);
        --newsletter-accent-glow: rgba(124, 131, 253, 0.3);
        --newsletter-error-ring: rgba(248, 113, 113, 0.2);

        display: flex;
        justify-content: center;
        padding: var(--space-2xl) var(--space-md) var(--space-3xl);
    }

    .newsletter__inner {
        width: 100%;
        max-width: 32rem;
        text-align: center;
    }

    .newsletter__title {
        font-size: clamp(1.25rem, 3vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin-bottom: var(--space-sm);
        color: var(--color-text);
    }

    .newsletter__subtitle {
        font-size: clamp(0.875rem, 2vw, 0.95rem);
        color: var(--color-muted);
        line-height: 1.6;
        margin-bottom: var(--space-xl);
    }

    /* ─── Form card ──────────────────────────────────────── */
    .newsletter__form {
        position: relative;
        padding: var(--space-md);
        text-align: left;
        background-color: rgba(19, 22, 29, 0.55);
        border: 1px solid rgba(242, 244, 248, 0.1);
        border-radius: 1rem;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 6px 18px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px) saturate(135%);
        -webkit-backdrop-filter: blur(12px) saturate(135%);
        overflow: hidden;
        isolation: isolate;
    }

    .newsletter__form::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.2),
            transparent
        );
        opacity: 0.6;
        z-index: 1;
        pointer-events: none;
    }

    /* ─── Form Row ───────────────────────────────────────── */
    .newsletter__row {
        display: flex;
        gap: var(--space-sm);
        align-items: stretch;
        position: relative;
        z-index: 2;
    }

    /* ─── Input ──────────────────────────────────────────── */
    .newsletter__input {
        flex: 1 1 auto;
        min-width: 0;
        padding: 0 var(--space-md);
        height: 3.25rem;
        font-family: var(--font-body);
        font-size: 0.9375rem;
        color: var(--color-text);
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.85rem;
        outline: none;
        transition:
            border-color 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out),
            opacity 0.25s var(--ease-out);
    }

    .newsletter__input::placeholder {
        color: var(--color-muted);
        opacity: 0.75;
    }

    .newsletter__input:focus-visible {
        border-color: var(--color-accent);
        box-shadow: 0 0 0 3px var(--newsletter-accent-ring);
    }

    .newsletter__input.is-error {
        border-color: var(--newsletter-error);
        box-shadow: 0 0 0 3px var(--newsletter-error-ring);
    }

    .newsletter__input:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    /* ─── Button ─────────────────────────────────────────── */
    .newsletter__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 0 var(--space-xl);
        height: 3.25rem;
        font-family: var(--font-body);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--newsletter-on-accent);
        background-color: var(--color-accent);
        border: none;
        border-radius: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
        transition:
            background-color 0.25s var(--ease-out),
            color 0.25s var(--ease-out),
            transform 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out),
            opacity 0.25s var(--ease-out);
        will-change: transform;
    }

    .newsletter__button:hover,
    .newsletter__button:focus-visible {
        background-color: var(--color-accent-hover);
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 8px 24px var(--newsletter-accent-glow);
    }

    .newsletter__button:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
    }

    .newsletter__button:disabled {
        cursor: not-allowed;
    }

    /* Estados del botón */
    .newsletter__button.is-loading {
        opacity: 0.65;
        cursor: wait;
        transform: none;
        box-shadow: none;
    }

    .newsletter__button.is-loading:hover {
        transform: none;
        box-shadow: none;
    }

    .newsletter__button.is-success {
        background-color: var(--newsletter-success);
        color: var(--newsletter-on-accent);
        cursor: default;
    }

    .newsletter__button.is-success:hover {
        background-color: var(--newsletter-success);
        transform: none;
        box-shadow: none;
    }

    .newsletter__button.is-error {
        background-color: var(--newsletter-error);
        color: var(--newsletter-on-accent);
        cursor: default;
    }

    .newsletter__button.is-error:hover {
        background-color: var(--newsletter-error);
        transform: none;
        box-shadow: none;
    }

    /* ─── Message ────────────────────────────────────────── */
    .newsletter__message {
        min-height: 1.5rem;
        margin-top: var(--space-md);
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--color-muted);
        transition: color 0.2s var(--ease-out);
    }

    .newsletter__message--success {
        color: var(--newsletter-success);
    }

    .newsletter__message--error {
        color: var(--newsletter-error);
    }

    /* ─── Noscript ───────────────────────────────────────── */
    .newsletter__noscript {
        margin-top: var(--space-md);
        font-size: 0.8125rem;
        color: var(--color-muted);
        opacity: 0.7;
        line-height: 1.5;
    }

    /* ─── Responsive ─────────────────────────────────────── */
    @media (max-width: 479px) {
        .newsletter__form {
            padding: var(--space-sm);
        }

        .newsletter__row {
            flex-direction: column;
            gap: var(--space-sm);
        }

        .newsletter__input,
        .newsletter__button {
            width: 100%;
        }
    }

    @media (min-width: 480px) {
        .newsletter__button {
            padding: 0 var(--space-xl);
        }
    }

    @media (min-width: 768px) {
        .newsletter {
            padding: var(--space-3xl) var(--space-xl);
        }
    }

    /* ─── Reduced motion ─────────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .newsletter__input,
        .newsletter__button,
        .newsletter__message {
            transition: none;
        }

        .newsletter__button:hover,
        .newsletter__button:focus-visible {
            transform: none;
        }
    }
</style>
