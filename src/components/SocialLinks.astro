---

<nav class="social reveal" aria-label="Redes sociales">
    <ul class="social__list" role="list">
        {socialLinks.links.map((link) => (
            <li class="social__item">
                <a
                    class="social__link"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                >
                    <svg
                        class="social__icon"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path d={iconPaths[link.icon as IconName]} />
                    </svg>
                </a>
            </li>
        ))}
    </ul>
</nav>

<style>
    .social {
        display: flex;
        justify-content: center;
        padding: var(--space-xl) var(--space-md) 0;
        animation: fadeInUp 0.85s var(--ease-out) 0.44s both;
    }

    .social__list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-sm);
        list-style: none;
        max-width: 26rem;
    }

    .social__link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 1rem;
        color: var(--color-muted);
        background-color: rgba(19, 22, 29, 0.55);
        border: 1px solid rgba(242, 244, 248, 0.1);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 6px 18px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px) saturate(135%);
        -webkit-backdrop-filter: blur(12px) saturate(135%);
        overflow: hidden;
        isolation: isolate;
        transition:
            color 0.25s var(--ease-out),
            transform 0.25s var(--ease-spring),
            border-color 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out);
        will-change: transform;
    }

    /* Inner top highlight */
    .social__link::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.25),
            transparent
        );
        opacity: 0.6;
        z-index: 1;
    }

    /* Spotlight glow */
    .social__link::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: radial-gradient(
            circle at 50% 50%,
            rgba(124, 131, 253, 0.35) 0%,
            transparent 70%
        );
        opacity: 0;
        transition: opacity 0.3s var(--ease-out);
    }

    .social__link:hover,
    .social__link:focus-visible {
        color: var(--color-text);
        border-color: rgba(124, 131, 253, 0.4);
        transform: translateY(-4px) scale(1.06);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.08),
            0 10px 28px rgba(0, 0, 0, 0.35),
            0 0 24px rgba(124, 131, 253, 0.18);
    }

    .social__link:hover::after,
    .social__link:focus-visible::after {
        opacity: 1;
    }

    .social__icon {
        position: relative;
        z-index: 2;
        width: 1.45rem;
        height: 1.45rem;
        flex-shrink: 0;
    }

    @media (min-width: 480px) {
        .social__list {
            gap: var(--space-md);
        }

        .social__link {
            width: 3.5rem;
            height: 3.5rem;
        }

        .social__icon {
            width: 1.55rem;
            height: 1.55rem;
        }
    }
</style>
