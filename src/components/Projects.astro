---
import { projectsConfig } from "../config/projects";
import type { ProjectStatus } from "../config/projects";
import ProjectSubscribe from "./ProjectSubscribe.astro";

const { projects } = projectsConfig;
const projectCount = projects.length;

const badgeClassMap: Record<ProjectStatus, string> = {
  coming_soon: "projects__badge--coming-soon",
  in_development: "projects__badge--in-development",
  available: "projects__badge--available",
};
---

<section class="projects" aria-label="Proyectos">
  <div class="projects__pin-container">
    <div class="projects__sticky">
      <header class="projects__header reveal">
        <h2 class="projects__heading">Nuestros juegos</h2>
        <p class="projects__subheading">Descubre lo que estamos creando.</p>
      </header>

      <div class="projects__stage">
        <ul class="projects__list" role="list">
          {
            projects.map((project, index) => (
              <li
                class="projects__item"
                role="listitem"
                data-index={index}
              >
                <article class="projects__card">
                  <div class="projects__media">
                    {project.image ? (
                      <img
                        class="projects__card-image"
                        src={project.image}
                        alt={project.title}
                        width="640"
                        height="360"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div
                        class="projects__image-placeholder"
                        aria-hidden="true"
                      >
                        <span class="projects__initial">
                          {project.title.charAt(0)}
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="projects__body">
                    <span
                      class:list={[
                        "projects__badge",
                        badgeClassMap[project.status],
                      ]}
                    >
                      {project.statusLabel}
                    </span>

                    <h3 class="projects__name">{project.title}</h3>
                    <p class="projects__description">{project.description}</p>

                    {project.links && project.links.length > 0 && (
                      <div class="projects__links">
                        {project.links.map((link) => (
                          <a
                            class="projects__link"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}

                    {project.subscribe && (
                      <ProjectSubscribe projectId={project.id} inline />
                    )}
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="projects__dots">
        {
          projects.map((_, index) => (
            <button
              class="projects__dot"
              type="button"
              aria-label={`Proyecto ${index + 1} de ${projects.length}`}
              aria-current={index === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Fallbacks: no scroll-hijack for reduced motion, touch devices,
    // no-JS environments, or when there is only one real project.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(pointer: coarse)").matches) return;

    var section = document.querySelector(".projects");
    var container = document.querySelector(".projects__pin-container");
    var stage = document.querySelector(".projects__stage");
    var items = stage ? stage.querySelectorAll(".projects__item") : [];
    var dots = document.querySelectorAll(".projects__dot");
    if (!section || !container || !stage || !items.length) return;

    var projectCount = items.length;
    if (projectCount <= 1) return;

    section.classList.add("projects--hijack");

    var SIDE_SCALE = 0.78;
    var SIDE_OPACITY = 0.5;
    var TICKING = false;

    function recalc() {
      // One viewport of scroll per card transition.
      container.style.height = window.innerHeight * projectCount + "px";
    }

    function updateDots(activeIndex) {
      dots.forEach(function (dot, i) {
        dot.classList.toggle("is-active", i === activeIndex);
        dot.setAttribute("aria-current", i === activeIndex ? "true" : "false");
      });
    }

    function layout() {
      TICKING = false;

      var rect = container.getBoundingClientRect();
      var runway = container.offsetHeight - window.innerHeight;
      var progress = runway > 0 ? Math.max(0, Math.min(1, -rect.top / runway)) : 0;

      // Linear carousel position: 0 = first card, projectCount-1 = last card.
      var position = progress * (projectCount - 1);
      var activeIndex = Math.round(position);
      updateDots(activeIndex);

      var centerCard = items[0].querySelector(".projects__card");
      var cardWidth = centerCard ? centerCard.offsetWidth : stage.offsetWidth;
      var cardOffset = cardWidth * 0.72;

      items.forEach(function (item, i) {
        // Linear offset — no circular wrap.
        // First card: left side empty. Last card: right side empty.
        var offset = i - position;
        var absOffset = Math.abs(offset);

        var t = Math.min(absOffset, 1);
        var scale = 1 - t * (1 - SIDE_SCALE);
        var opacity = 1 - t * (1 - SIDE_OPACITY);
        if (absOffset > 1) opacity = 0;

        var zIndex = absOffset < 0.5 ? 2 : 1;
        var blur = absOffset > 0.05 ? "1px" : "0px";
        var translateX = offset * cardOffset;

        item.style.transform =
          "translate(-50%, -50%) translateX(" +
          translateX +
          "px) scale(" +
          scale +
          ")";
        item.style.opacity = String(opacity);
        item.style.zIndex = String(zIndex);
        item.style.filter = "blur(" + blur + ")";
      });
    }

    function onScroll() {
      if (!TICKING) {
        window.requestAnimationFrame(layout);
        TICKING = true;
      }
    }

    recalc();
    layout();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", function () {
      recalc();
      layout();
    });
    window.addEventListener("load", function () {
      recalc();
      layout();
    });

    dots.forEach(function (dot, i) {
      dot.addEventListener("click", function () {
        var runway = container.offsetHeight - window.innerHeight;
        var targetProgress = i / (projectCount - 1);
        var targetScroll = container.offsetTop + targetProgress * runway;
        window.scrollTo({ top: targetScroll, behavior: "smooth" });
      });
    });
  })();
</script>

<style>
  /* ─── Base layout (native horizontal scroll fallback) ──── */
  .projects__pin-container {
    position: relative;
    height: auto;
  }

  .projects__sticky {
    position: relative;
    height: auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .projects__header {
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .projects__heading {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .projects__subheading {
    font-size: clamp(0.9375rem, 2.2vw, 1.05rem);
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* ─── Stage & track ────────────────────────────────────── */
  .projects__stage {
    position: relative;
  }

  .projects__list {
    --card-width: min(90vw, 40rem);

    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding: var(--space-md);
    list-style: none;
    padding: var(--space-sm) var(--space-md) var(--space-lg);
    margin: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .projects__list::-webkit-scrollbar {
    display: none;
  }

  .projects__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  /* ─── Project card ─────────────────────────────────────── */
  .projects__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: var(--card-width);
    height: min(82vh, 42rem);
    border-radius: 1.25rem;
    background-color: rgba(19, 22, 29, 0.55);
    border: 1px solid rgba(242, 244, 248, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 6px 18px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(12px) saturate(135%);
    -webkit-backdrop-filter: blur(12px) saturate(135%);
    overflow: hidden;
    isolation: isolate;
    transition:
      box-shadow 0.35s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .projects__card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    opacity: 0.6;
    z-index: 1;
    pointer-events: none;
  }

  .projects__card:hover,
  .projects__card:focus-within {
    border-color: rgba(124, 131, 253, 0.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 14px 32px rgba(0, 0, 0, 0.35),
      0 0 24px rgba(124, 131, 253, 0.18);
  }

  /* ─── Card media ───────────────────────────────────────── */
  .projects__media {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 14rem;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .projects__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .projects__card:hover .projects__card-image,
  .projects__card:focus-within .projects__card-image {
    transform: scale(1.06);
  }

  .projects__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--color-teal),
      var(--color-indigo)
    );
  }

  .projects__initial {
    font-size: 6rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.9);
    text-transform: uppercase;
    letter-spacing: -0.04em;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
  }

  /* ─── Card body ────────────────────────────────────────── */
  .projects__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    flex: 1 1 auto;
    padding: var(--space-lg);
    overflow: hidden;
  }

  .projects__badge {
    align-self: flex-start;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .projects__badge--coming-soon {
    color: #fbbf24;
    background-color: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.25);
  }

  .projects__badge--in-development {
    color: var(--color-accent-hover);
    background-color: rgba(124, 131, 253, 0.12);
    border: 1px solid rgba(124, 131, 253, 0.25);
  }

  .projects__badge--available {
    color: #34d399;
    background-color: rgba(0, 160, 128, 0.12);
    border: 1px solid rgba(0, 160, 128, 0.25);
  }

  .projects__name {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text);
  }

  .projects__description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-muted);
    line-height: 1.65;
    flex: 1 1 auto;
    overflow-y: auto;
  }

  /* ─── Links ────────────────────────────────────────────── */
  .projects__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .projects__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-bg);
    background-color: var(--color-accent);
    border-radius: 0.85rem;
    transition:
      background-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-spring),
      box-shadow 0.25s var(--ease-out);
    will-change: transform;
  }

  .projects__link:hover,
  .projects__link:focus-visible {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 8px 20px rgba(124, 131, 253, 0.25);
  }

  /* ─── Progress dots ────────────────────────────────────── */
  .projects__dots {
    display: none;
    position: absolute;
    bottom: var(--space-xl);
    left: 0;
    right: 0;
    justify-content: center;
    gap: var(--space-sm);
    z-index: 3;
  }

  .projects__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background-color: var(--color-muted);
    opacity: 0.4;
    cursor: pointer;
    transition:
      width 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  .projects__dot.is-active {
    width: 1.5rem;
    background-color: var(--color-accent);
    opacity: 1;
  }

  .projects__dot:hover,
  .projects__dot:focus-visible {
    opacity: 0.8;
  }

  /* ─── Scroll-hijack / coverflow mode ───────────────────── */
  .projects--hijack .projects__pin-container {
    /* height is set inline by JS */
  }

  .projects--hijack .projects__sticky {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    min-height: 100vh;
    padding: 0;
    overflow: hidden;
  }

  .projects--hijack .projects__header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding-top: var(--space-xl);
    margin: 0 auto;
    z-index: 3;
  }

  .projects--hijack .projects__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .projects--hijack .projects__list {
    position: absolute;
    inset: 0;
    display: block;
    overflow: visible;
    scroll-snap-type: none;
    padding: 0;
    margin: 0;
  }

  .projects--hijack .projects__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-width);
    will-change: transform, opacity;
  }

  .projects--hijack .projects__card {
    width: 100%;
  }

  .projects--hijack .projects__dots {
    display: flex;
  }

  /* ─── Responsive native mode tweaks ────────────────────── */
  @media (min-width: 768px) {
    .projects__sticky {
      padding: var(--space-3xl) var(--space-xl);
    }

    .projects__list {
      gap: var(--space-lg);
      scroll-padding: var(--space-lg);
    }

    .projects__body {
      padding: var(--space-xl);
    }
  }

  /* ─── Short viewports (panoramic / landscape) ─────────── */
  /* Reduce media height and spacing so the subscribe form fits. */
  @media (max-height: 820px) {
    .projects__card {
      height: min(84vh, 42rem);
    }

    .projects__media {
      max-height: 10rem;
    }

    .projects__body {
      gap: var(--space-sm);
      padding: var(--space-md);
    }

    .projects__name {
      font-size: clamp(1.25rem, 3vw, 1.75rem);
    }

    .projects__description {
      font-size: 0.9375rem;
      line-height: 1.55;
    }
  }

  @media (max-height: 620px) {
    .projects__card {
      height: min(88vh, 42rem);
    }

    .projects__media {
      max-height: 7rem;
    }

    .projects__body {
      gap: var(--space-xs);
      padding: var(--space-sm);
    }

    .projects__initial {
      font-size: 4rem;
    }
  }

  /* ─── Reduced motion ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .projects__card {
      transition: none;
    }

    .projects__card-image {
      transition: none;
    }

    .projects__dot {
      transition: none;
    }
  }

  /* ─── No-JS fallback ───────────────────────────────────── */
  @media (scripting: none) {
    .projects__list {
      overflow-x: auto;
    }
  }
</style>
