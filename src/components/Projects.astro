---
import { projectsConfig } from "../config/projects";
import ProjectCard from "./ProjectCard.astro";

const { projects: allProjects } = projectsConfig;
const projects = allProjects.filter((p) => p.visible !== false);
---

<section class="projects" aria-label="Proyectos">
  <div class="projects__pin-container">
    <div class="projects__sticky">
      <header class="projects__header reveal">
        <h2 class="projects__heading">Nuestros juegos</h2>
        <p class="projects__subheading">Descubre lo que estamos creando.</p>
      </header>

      <div class="projects__stage">
        <ul class="projects__list" role="list">
          {
            projects.map((project, index) => (
              <li
                class="projects__item"
                role="listitem"
                data-index={index}
              >
                <ProjectCard project={project} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="projects__dots">
        {
          projects.map((_, index) => (
            <button
              class="projects__dot"
              type="button"
              aria-label={`Proyecto ${index + 1} de ${projects.length}`}
              aria-current={index === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Fallbacks: no scroll-hijack for reduced motion, touch devices,
    // no-JS environments, or when there is only one real project.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(pointer: coarse)").matches) return;

    var section = document.querySelector(".projects");
    var container = document.querySelector(".projects__pin-container");
    var stage = document.querySelector(".projects__stage");
    var items = stage ? stage.querySelectorAll(".projects__item") : [];
    var dots = document.querySelectorAll(".projects__dot");
    if (!section || !container || !stage || !items.length) return;

    var projectCount = items.length;
    if (projectCount <= 1) return;

    section.classList.add("projects--hijack");

    var SIDE_SCALE = 0.78;
    var SIDE_OPACITY = 0.5;
    var TICKING = false;

    // Snap-to-nearest: when the user stops scrolling, animate to the
    // closest card position so the carousel never rests between cards.
    var SNAP_DELAY = 150;
    var snapTimer = null;
    var isSnapping = false;
    var snapTarget = -1;
    var currentPosition = 0;

    function recalc() {
      // One viewport of scroll per card transition.
      container.style.height = window.innerHeight * projectCount + "px";
    }

    function updateDots(activeIndex) {
      dots.forEach(function (dot, i) {
        dot.classList.toggle("is-active", i === activeIndex);
        dot.setAttribute("aria-current", i === activeIndex ? "true" : "false");
      });
    }

    function scrollToIndex(i) {
      isSnapping = true;
      snapTarget = i;
      var runway = container.offsetHeight - window.innerHeight;
      var targetProgress = i / (projectCount - 1);
      var targetScroll = container.offsetTop + targetProgress * runway;
      window.scrollTo({ top: targetScroll, behavior: "smooth" });
    }

    function snapToNearest() {
      snapTimer = null;
      var nearest = Math.round(currentPosition);
      if (Math.abs(currentPosition - nearest) < 0.01) return;
      scrollToIndex(nearest);
    }

    function layout() {
      TICKING = false;

      var rect = container.getBoundingClientRect();
      var runway = container.offsetHeight - window.innerHeight;
      var progress = runway > 0 ? Math.max(0, Math.min(1, -rect.top / runway)) : 0;

      // Linear carousel position: 0 = first card, projectCount-1 = last card.
      var position = progress * (projectCount - 1);
      currentPosition = position;
      var activeIndex = Math.round(position);
      updateDots(activeIndex);

      // Clear snapping flag when we reach the target position.
      if (isSnapping && Math.abs(position - snapTarget) < 0.02) {
        isSnapping = false;
        snapTarget = -1;
      }

      var centerCard = items[0].querySelector(".projects__card");
      var cardWidth = centerCard ? centerCard.offsetWidth : stage.offsetWidth;
      var cardOffset = cardWidth * 0.72;

      items.forEach(function (item, i) {
        // Linear offset — no circular wrap.
        // First card: left side empty. Last card: right side empty.
        var offset = i - position;
        var absOffset = Math.abs(offset);

        var t = Math.min(absOffset, 1);
        var scale = 1 - t * (1 - SIDE_SCALE);
        var opacity = 1 - t * (1 - SIDE_OPACITY);

        // Smooth fade-out beyond the adjacent position (1 < absOffset <= 1.5).
        // This lets the next card appear before the far card disappears,
        // so side cards are always visible while transitioning.
        if (absOffset > 1) {
          opacity *= Math.max(0, 1 - (absOffset - 1) / 0.5);
        }

        var isHidden = absOffset > 1.5;
        if (isHidden) opacity = 0;

        var zIndex = absOffset < 0.5 ? 2 : 1;
        var blur = absOffset > 0.05 ? "1px" : "0px";
        var translateX = offset * cardOffset;

        item.style.transform =
          "translate(-50%, -50%) translateX(" +
          translateX +
          "px) scale(" +
          scale +
          ")";
        item.style.opacity = String(opacity);
        item.style.zIndex = String(zIndex);
        item.style.filter = "blur(" + blur + ")";
        item.style.pointerEvents = isHidden ? "none" : "auto";

        // Side cards are clickable/keyboard-activatable to center them.
        // Only cards within visible range (absOffset <= 1) are interactive.
        var nameEl = item.querySelector(".projects__name");
        var title = nameEl ? nameEl.textContent || "" : "";

        if (absOffset > 0.5 && !isHidden) {
          item.classList.add("is-side");
          item.setAttribute("tabindex", "0");
          item.setAttribute("role", "button");
          item.setAttribute("aria-label", "Ver proyecto " + title);
        } else {
          item.classList.remove("is-side");
          item.removeAttribute("tabindex");
          item.setAttribute("role", "listitem");
          item.removeAttribute("aria-label");
        }
      });
    }

    function onScroll() {
      if (!TICKING) {
        window.requestAnimationFrame(layout);
        TICKING = true;
      }

      // If a programmatic snap is in progress, detect user interruption:
      // if the position deviates far from target, the user took over.
      if (isSnapping) {
        if (snapTarget >= 0 && Math.abs(currentPosition - snapTarget) > 0.3) {
          isSnapping = false;
          snapTarget = -1;
          if (snapTimer) clearTimeout(snapTimer);
          snapTimer = setTimeout(snapToNearest, SNAP_DELAY);
        }
        return;
      }

      // Debounce: when scrolling stops, snap to the nearest card.
      if (snapTimer) clearTimeout(snapTimer);
      snapTimer = setTimeout(snapToNearest, SNAP_DELAY);
    }

    recalc();
    layout();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", function () {
      recalc();
      layout();
    });
    window.addEventListener("load", function () {
      recalc();
      layout();
    });

    dots.forEach(function (dot, i) {
      dot.addEventListener("click", function () {
        scrollToIndex(i);
      });
    });

    items.forEach(function (item, i) {
      item.addEventListener("click", function (e) {
        if (!item.classList.contains("is-side")) return;
        // Don't hijack clicks on interactive descendants.
        if (e.target.closest("a, button, input, textarea")) return;
        item.focus();
        scrollToIndex(i);
      });

      item.addEventListener("keydown", function (e) {
        if (!item.classList.contains("is-side")) return;
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          scrollToIndex(i);
        }
      });
    });
  })();
</script>

<style>
  /* ─── Base layout (native horizontal scroll fallback) ──── */
  .projects__pin-container {
    position: relative;
    height: auto;
  }

  .projects__sticky {
    position: relative;
    height: auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .projects__header {
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .projects__heading {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .projects__subheading {
    font-size: clamp(0.9375rem, 2.2vw, 1.05rem);
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* ─── Stage & track ────────────────────────────────────── */
  .projects__stage {
    position: relative;
  }

  .projects__list {
    --card-width: min(90vw, 40rem);

    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding: var(--space-md);
    list-style: none;
    padding: var(--space-sm) var(--space-md) var(--space-lg);
    margin: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .projects__list::-webkit-scrollbar {
    display: none;
  }

  .projects__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  /* Center the card when there's only one project (native scroll mode). */
  .projects__item:only-child {
    margin-inline: auto;
  }

  /* ─── Progress dots ────────────────────────────────────── */
  .projects__dots {
    display: none;
    position: absolute;
    bottom: var(--space-xl);
    left: 0;
    right: 0;
    justify-content: center;
    gap: var(--space-sm);
    z-index: 3;
  }

  .projects__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background-color: var(--color-muted);
    opacity: 0.4;
    cursor: pointer;
    transition:
      width 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  .projects__dot.is-active {
    width: 1.5rem;
    background-color: var(--color-accent);
    opacity: 1;
  }

  .projects__dot:hover,
  .projects__dot:focus-visible {
    opacity: 0.8;
  }

  /* ─── Scroll-hijack / coverflow mode ───────────────────── */
  .projects--hijack .projects__pin-container {
    /* height is set inline by JS */
  }

  .projects--hijack .projects__sticky {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    min-height: 100vh;
    padding: 0;
    overflow: hidden;
  }

  .projects--hijack .projects__header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding-top: var(--space-xl);
    margin: 0 auto;
    z-index: 3;
  }

  .projects--hijack .projects__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .projects--hijack .projects__list {
    position: absolute;
    inset: 0;
    display: block;
    overflow: visible;
    scroll-snap-type: none;
    padding: 0;
    margin: 0;
  }

  .projects--hijack .projects__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-width);
    will-change: transform, opacity;
  }

  .projects--hijack :global(.projects__card) {
    width: 100%;
  }

  /* Side cards are clickable to center them. */
  .projects--hijack .projects__item.is-side {
    cursor: pointer;
  }

  .projects--hijack .projects__item.is-side:hover :global(.projects__card),
  .projects--hijack .projects__item.is-side:focus-visible :global(.projects__card) {
    filter: brightness(1.1);
  }

  .projects--hijack .projects__dots {
    display: flex;
  }

  /* ─── Responsive native mode tweaks ────────────────────── */
  @media (min-width: 768px) {
    .projects__sticky {
      padding: var(--space-3xl) var(--space-xl);
    }

    .projects__list {
      gap: var(--space-lg);
      scroll-padding: var(--space-lg);
    }

  }

  /* ─── Reduced motion ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .projects__dot {
      transition: none;
    }
  }

  /* ─── No-JS fallback ───────────────────────────────────── */
  @media (scripting: none) {
    .projects__list {
      overflow-x: auto;
    }
  }
</style>
