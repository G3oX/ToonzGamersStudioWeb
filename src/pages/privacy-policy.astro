---
import MainLayout from "../layouts/MainLayout.astro";
import { privacyPolicyConfig as policy } from "../config/privacy-policy";

const contactHref = `mailto:${policy.contact.email}`;
---

<MainLayout
    title={policy.title}
    description={policy.description}
>
    <main>
        <article class="policy reveal">
            <header class="policy__header">
                <a class="policy__back" href="/" aria-label="Volver al inicio">
                    ← Volver al inicio
                </a>
                <h1 class="policy__title">{policy.title}</h1>
                <p class="policy__updated">
                    <span class="policy__updated-label">Última actualización: </span>
                    {policy.lastUpdated}
                </p>
            </header>

            <div class="policy__body">
                {
                    policy.sections.map((section) => (
                        <section class="policy__section" id={`seccion-${section.id}`}>
                            <h2 class="policy__section-title">
                                <span class="policy__section-number">{section.id}.</span>
                                {section.title}
                            </h2>

                            {section.paragraphs?.map((p) => (
                                <p class="policy__paragraph">{p}</p>
                            ))}

                            {section.list && (
                                <ul class="policy__list">
                                    {section.list.map((item) => (
                                        <li class="policy__list-item">{item}</li>
                                    ))}
                                </ul>
                            )}

                            {section.subsections?.map((sub) => (
                                <div class="policy__subsection">
                                    <h3 class="policy__subsection-title">
                                        <span class="policy__subsection-number">{sub.id}</span>
                                        {sub.title}
                                    </h3>
                                    <ul class="policy__list">
                                        {sub.list.map((item) => (
                                            <li class="policy__list-item">{item}</li>
                                        ))}
                                    </ul>
                                </div>
                            ))}

                            {section.id === "14" && (
                                <div class="policy__contact">
                                    <p class="policy__contact-name">{policy.contact.name}</p>
                                    <p>
                                        Correo electrónico:{" "}
                                        <a
                                            class="policy__contact-email"
                                            href={contactHref}
                                        >
                                            {policy.contact.email}
                                        </a>
                                    </p>
                                </div>
                            )}
                        </section>
                    ))
                }
            </div>

            <footer class="policy__footer">
                <a class="policy__back" href="/" aria-label="Volver al inicio">
                    ← Volver al inicio
                </a>
            </footer>
        </article>
    </main>
</MainLayout>

<style>
    .policy {
        max-width: 50rem;
        margin: 0 auto;
        padding: var(--space-3xl) var(--space-lg) var(--space-2xl);
        position: relative;
        z-index: var(--z-content);
    }

    .policy__header {
        margin-bottom: var(--space-2xl);
        padding-bottom: var(--space-xl);
        border-bottom: 1px solid var(--color-border);
    }

    .policy__back {
        display: inline-block;
        font-size: 0.875rem;
        color: var(--color-muted);
        margin-bottom: var(--space-xl);
        transition: color var(--duration-fast) var(--ease-out);
    }

    .policy__back:hover {
        color: var(--color-accent-hover);
    }

    .policy__title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: var(--space-md);
        background: linear-gradient(
            120deg,
            var(--color-text) 0%,
            var(--color-accent-hover) 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .policy__updated {
        font-size: 0.9375rem;
        color: var(--color-muted);
    }

    .policy__updated-label {
        font-weight: 600;
        color: var(--color-text);
    }

    .policy__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xl);
    }

    .policy__section {
        scroll-margin-top: var(--space-xl);
    }

    .policy__section-title {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: var(--space-md);
        color: var(--color-text);
    }

    .policy__section-number {
        color: var(--color-accent);
        margin-right: var(--space-xs);
    }

    .policy__paragraph {
        color: var(--color-text);
        line-height: 1.7;
        margin-bottom: var(--space-md);
    }

    .policy__paragraph:last-child {
        margin-bottom: 0;
    }

    .policy__list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        margin: var(--space-md) 0;
        padding-left: var(--space-md);
    }

    .policy__list-item {
        position: relative;
        padding-left: var(--space-md);
        color: var(--color-text);
        line-height: 1.65;
    }

    .policy__list-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.7em;
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 50%;
        background: var(--color-accent);
        opacity: 0.7;
    }

    .policy__subsection {
        margin-top: var(--space-lg);
    }

    .policy__subsection-title {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: var(--space-sm);
    }

    .policy__subsection-number {
        color: var(--color-accent);
        margin-right: var(--space-xs);
        font-variant-numeric: tabular-nums;
    }

    .policy__contact {
        margin-top: var(--space-md);
        padding: var(--space-lg);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.75rem;
    }

    .policy__contact-name {
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: var(--space-xs);
    }

    .policy__contact-email {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .policy__contact-email:hover {
        color: var(--color-accent-hover);
    }

    .policy__footer {
        margin-top: var(--space-3xl);
        padding-top: var(--space-xl);
        border-top: 1px solid var(--color-border);
        text-align: center;
    }

    @media (max-width: 640px) {
        .policy {
            padding: var(--space-2xl) var(--space-md) var(--space-xl);
        }

        .policy__list {
            padding-left: 0;
        }
    }
</style>
