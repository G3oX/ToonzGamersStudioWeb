# ─────────────────────────────────────────────────────────────
# Variables de entorno del Worker (NO de la web Astro)
# ─────────────────────────────────────────────────────────────
# La web Astro es estática y NO usa variables de entorno.
# Estas variables pertenecen al Cloudflare Worker (carpeta worker/)
# y se configuran con `wrangler secret put` o en el dashboard.
# NUNCA se commitean valores reales.

# Clave de API de Brevo (v3). Se obtiene en:
#   Brevo → Transacciones → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-tu-api-key-de-brevo

# ID numérico de la lista de contactos en Brevo. Se obtiene en:
#   Brevo → Contacts → Lists → (crear o abrir lista) → copiar ID
BREVO_LIST_ID=42

# ─────────────────────────────────────────────────────────────
# Variables públicas del Worker (van en wrangler.toml [vars])
# ─────────────────────────────────────────────────────────────
# Origins permitidos para CORS, separados por comas.
# El Worker solo acepta peticiones desde estos dominios.
ALLOWED_ORIGINS=https://toonzgamers.com

# ─────────────────────────────────────────────────────────────
# Cómo configurar los secrets
# ─────────────────────────────────────────────────────────────
#   cd worker
#   npx wrangler secret put BREVO_API_KEY
#   npx wrangler secret put BREVO_LIST_ID
#
# Para desarrollo local, copia este archivo a worker/.dev.vars
# y rellena los valores reales. worker/.dev.vars NO se commitea.